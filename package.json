{
  "name": "gabecubeaura",
  "version": "1.3.3-lab.6",
  "description": "Real-time audio, screen colours, artwork, weather and live status lighting for the official Steam Machine",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "rollup -c -w",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "PYTHONPYCACHEPREFIX=/tmp/gabecubeaura-pycache PYTHONPATH=py_modules python3 -m unittest discover -s tests/backend -v",
    "test:frontend": "tsx --test tests/frontend/*.test.ts",
    "typecheck": "tsc --noEmit",
    "package": "python3 scripts/package_plugin.py",
    "media:release": "node scripts/capture_release_gifs.mjs"
  },
  "keywords": [
    "decky",
    "steam-machine",
    "steamos",
    "led",
    "status"
  ],
  "author": "Alyenax",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alyenax/GabeCubeAura.git"
  },
  "bugs": {
    "url": "https://github.com/Alyenax/GabeCubeAura/issues"
  },
  "homepage": "https://github.com/Alyenax/GabeCubeAura#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "tsx": "^4.20.5",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
